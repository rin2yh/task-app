{
  "name": "my-task-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "vite build --config config/vite.config.ts",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:workers": "mkdir -p dist/client && vitest run --config config/vitest.workers.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsgo --noEmit",
    "db:generate": "drizzle-kit generate --config config/drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply task-app-local --local",
    "db:migrate:prod": "wrangler d1 migrations apply task-app-prod --remote --env production",
    "db:migrate:develop": "wrangler d1 migrations apply task-app-develop --remote --env develop"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/inertia": "^0.1.0",
    "@inertiajs/react": "^2.0.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "arctic": "^2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "lucide-react": "^1.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "vite-ssr-components": "^0.6.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/vitest-pool-workers": "^0.16.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260424.2",
    "@vitejs/plugin-react": "^4.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.28.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.88.0"
  },
  "pnpm": {
    "overrides": {
      "rollup": "4.60.2",
      "workerd": "1.20260423.1",
      "workbox-build": "7.4.0",
      "workbox-window": "7.4.0"
    }
  }
}
